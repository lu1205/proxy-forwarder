{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proxy Forwarder",
  "version": "1.0.0",
  "identifier": "com.demo.proxyforwarder",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "接口请求转发客户端",
        "visible": false,
        "width": 980,
        "height": 720,
        "minWidth": 860,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Proxy Forwarder",
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    }
  }
}
